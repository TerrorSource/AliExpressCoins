# Kopieer naar .env en pas aan.

# Tijdzone en schema (lokale tijd, komma-gescheiden). AliExpress reset de check-in rond
# middernacht Pacific-tijd, dat is rond 09:00 Nederlandse tijd. Twee runs per dag is
# veilig: elke run doet alleen wat nog openstaat.
TZ=Europe/Amsterdam
SCHEDULE=10:30,20:30
# Willekeurige vertraging per run (minuten), zodat het niet elke dag op de seconde gelijk is.
JITTER_MINUTES=20
# Bij het opstarten meteen een run als vandaag nog niet is ingecheckt.
RUN_ON_START=true

# Wat er gedaan wordt
MOBILE_CHECKIN=true
PC_CHECKIN=true
TASKS=true
QUIZ=true
# "Water to win" in Prize Land: elke dag water geven (koopt nooit iets, kiest nooit een prijs).
PRIZE_LAND_WATER=true
# "Visit the page via coins shortcut": de link openen die de snelkoppeling van de app opent.
SHORTCUT_TASK=true
# Maximale tijd voor de taken per run (minuten).
TASK_BUDGET_MINUTES=30
# Taken waarvan de titel op deze regex lijkt worden nooit gedaan (leeg = geen).
TASK_BLOCKLIST=

# Optioneel: het ship-to-land alleen in de browser van de container (bijv. KR).
# Niet nodig; leeg laten houdt de instelling van je account.
COIN_REGION=
# De AliExpress-pagina's in het Engels tonen, zodat de knoppen betrouwbaar herkend worden.
FORCE_ENGLISH=true

# Meldingen via Apprise, komma-gescheiden. Voorbeelden:
#   ntfy://ntfy.sh/mijn-geheime-topic
#   tgram://BOTTOKEN/CHATID
#   hassio://homeassistant.local:8123/LONG_LIVED_TOKEN
NOTIFY_URLS=
# errors = alleen problemen (login verlopen, mislukt) | summary = ook een samenvatting na elke run | none
NOTIFY_LEVEL=errors

# Wachtwoord voor het webpaneel (sterk aangeraden zodra de poort niet alleen op 127.0.0.1 staat).
PANEL_USER=admin
PANEL_PASSWORD=
